    "**/articles/**/*.md",
    "**/blog/**/*.md",
    "**/posts/**/*.md",
    "**/newsletter/**/*.md",
    "**/launch/**/*.md",
    "**/social/**/*.md",
    "**/marketing/**/*.md",
    "**/outreach/**/*.md",
    "**/linkedin*.md",
    "**/twitter*.md",
    "**/x-*.md",
    "**/medium*.md",
    "**/substack*.md",
    "**/email-*.md",
    "**/email_*.md",
    "**/dm-*.md",
    "**/dm_*.md",
    "**/reply-*.md",
    "**/reply_*.md",
